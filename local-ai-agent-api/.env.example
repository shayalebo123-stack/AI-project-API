# Copy to .env if you want to override defaults used by docker-compose.yml

# Default: an older pinned image that runs without an account.
# LOCALSTACK_IMAGE=localstack/localstack:4.4.0

# To use the current LocalStack image you need a (free) auth token from https://app.localstack.cloud
# LOCALSTACK_IMAGE=localstack/localstack:latest
# LOCALSTACK_AUTH_TOKEN=your-token-here
